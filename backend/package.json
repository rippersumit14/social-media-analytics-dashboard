{
  "name": "creator-growth-software-backend",
  "version": "1.0.0",
  "description": "Backend for AI Powered Creator Growth Software built with Node.js, Express, MongoDB, Redis, Meta Graph API and AI integrations.",
  "main": "server.js",
  "type": "module",
  "private": true,

  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",

    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --setupFiles ./tests/jest.setup.js",

    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",

    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },

  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "redis",
    "creator-growth",
    "instagram",
    "analytics",
    "saas",
    "jwt",
    "ai",
    "backend"
  ],

  "author": "Sumit Pandey",

  "license": "MIT",

  "engines": {
    "node": ">=18.0.0"
  },

  "dependencies": {
    "@google/genai": "^2.6.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.8",
    "chalk": "^5.6.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "groq-sdk": "^1.2.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.5",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },

  "devDependencies": {
    "cross-env": "^10.0.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },

  "jest": {
    "testEnvironment": "node"
  }
}