PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
GROQ_API_KEY=your_groq_api_key
NODE_ENV=development

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_AI_CHAT_FOLDER=mern-ai-social-saas/ai-chat


# Email delivery via Resend HTTPS API
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Creator Growth AI <onboarding@resend.dev>"
CONTACT_RECEIVER_EMAIL=your_contact_receiver_email
EMAIL_DELIVERY_TIMEOUT_MS=15000

# Redis
REDIS_URL=redis://localhost:6379

# Meta / Instagram OAuth
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram/oauth/callback
INSTAGRAM_FRONTEND_CALLBACK_URL=http://localhost:5173/instagram/callback
META_GRAPH_VERSION=v23.0

# Public creator-market news feed
CREATOR_NEWS_REFRESH_CRON="15 8 * * *"
CREATOR_NEWS_COVER_FETCH_LIMIT=4
CREATOR_NEWS_UPLOAD_IMAGES=false
CREATOR_NEWS_IMAGE_FOLDER=creator-growth/news-covers

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
